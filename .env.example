# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Render
PORT=8080
DATA_DIR=/var/data
LOG_LEVEL=INFO
SYMBOLS=XRP,BNB,SOL,ETH,DOGE,HYPE

# Safe defaults
PAPER_START_BALANCE=500
MIN_FREE_CASH=5
LIVE_MASTER_ENABLE=0

# Polymarket wallet — NEVER commit real values to GitHub
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=

# Optional relayer credentials, only if you use them
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=

# Default sizes; Telegram SIZE command persists per-token values in SQLite
ENTRY_ORDER_SIZE=5
PYRAMID_ORDER_SIZE=10
LIVE_MIN_SHARES=0.01
LIVE_MAX_SHARES_PER_ORDER=1000

# Exact SAFE67 strategy defaults from source ZIP
DECISION_INTERVAL=3.0
TRADE_WINDOW_SECONDS=180
ENTRY_MOVE=0.03
PYRAMID_STEP=0.08
LOOKBACK_TICKS=2
V2_ELIGIBLE_PRICE_MIN=0.55
V2_ELIGIBLE_PRICE_MAX=0.75
V2_ELIGIBLE_MOM_MIN=0.03
V2_ELIGIBLE_MOM_MAX=0.30
SAFE_ENTRY_PRICE_MIN=0.67
SAFE_ENTRY_PRICE_MAX=0.75
SAFE_ENTRY_MOM_MIN=0.05
SAFE_ENTRY_MOM_MAX=0.10
PYRAMID_MOMENTUM_CAP=0.30
MAX_BUYS_SIDE=2
MIN_PRICE=0.08
MAX_PRICE=0.95

# Optional SL has no fixed default: each token starts with SL OFF.
# Set it from Telegram, e.g. SL XRP 0.40.
STOP_CHECK_INTERVAL=0.20

# Feeds / stability
CRYPTO_FEE_RATE=0.07
DISCOVERY_INTERVAL=10
MAX_BOOK_AGE_MS=1000
MEMORY_CLEANUP_INTERVAL=60
MEMORY_KEEP_RESOLVED_SEC=900
WS_MAX_CONNECTION_AGE_SEC=900
MEMORY_LOG_INTERVAL=300
