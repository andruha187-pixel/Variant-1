ENTRY_PRICE_MIN=0.55
ENTRY_PRICE_MAX=0.75
MOMENTUM_CAP=0.30
MIN_PRICE=0.08
MAX_PRICE=0.95

# Binance CONF60
BINANCE_SYMBOL=btcusdt
CONF_MIN=60
BINANCE_LARGE_TRADE_USD=50000
BINANCE_SIGNAL_MAX_AGE_MS=1500
REGIME_WINDOW_SEC=30
START_PRICE_CAPTURE_WINDOW_SEC=3
CONF_USE_BOOK=0
W_IMPULSE=22
W_FLOW=18
W_BOOK=14
W_LARGE=8
W_TREND=14
W_DISTANCE=18
